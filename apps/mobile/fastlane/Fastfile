require "plist"
require "tempfile"
require "open3"
require "rbconfig"
require "json"
require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Build and distribute FundWell to the existing internal TestFlight group"
  lane :testflight_internal do
    app_identifier = "com.restaurantprofit.restaurantProfitMobile"
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      is_key_content_base64: true,
      duration: 1200,
    )

    version = ENV.fetch("IOS_MARKETING_VERSION", "1.0.0")
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_identifier,
      version: version,
      initial_build_number: 0,
    )
    build_number = latest_build + 1

    mobile_root = File.expand_path("..", __dir__)
    pubspec = File.join(mobile_root, "pubspec.yaml")
    UI.user_error!("Flutter project root is invalid: #{mobile_root}") unless File.file?(pubspec)

    profile_name = ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")
    profile_uuid = ENV.fetch("IOS_PROVISIONING_PROFILE_UUID")
    shared_test_client_token = ENV.fetch("SHARED_TEST_CLIENT_TOKEN")
    if shared_test_client_token.bytesize < 32 || shared_test_client_token.match?(/\s/)
      UI.user_error!("SHARED_TEST_CLIENT_TOKEN must be a non-whitespace secret of at least 32 bytes")
    end
    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(mobile_root, "ios/Runner.xcodeproj"),
      team_id: "4R7CXGD5WK",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      bundle_identifier: app_identifier,
      build_configurations: ["Release"],
      targets: ["Runner"],
    )

    Tempfile.create(["FundWellExportOptions", ".plist"]) do |export_options|
      export_options.write(Plist::Emit.dump({
        "method" => "app-store-connect",
        "destination" => "export",
        "signingStyle" => "manual",
        "signingCertificate" => "Apple Distribution",
        "teamID" => "4R7CXGD5WK",
        "provisioningProfiles" => { app_identifier => profile_name },
        "manageAppVersionAndBuildNumber" => false,
        "uploadSymbols" => true,
      }))
      export_options.flush

      Tempfile.create(["FundWellNativeBuildConfig", ".json"]) do |build_config|
        build_config.chmod(0o600)
        build_config.write(JSON.generate({
          "API_BASE_URL" => "https://restaurantmanager-production-6231.up.railway.app/api/v1",
          "SHARED_TEST_USER_MODE" => true,
          "SHARED_TEST_CLIENT_TOKEN" => shared_test_client_token,
        }))
        build_config.flush

        Dir.chdir(mobile_root) do
          sh("flutter pub get")
          analysis_paths = %w[lib test]
          analysis_paths << "integration_test" if Dir.exist?("integration_test")
          sh("flutter analyze #{analysis_paths.join(' ')}")
          sh("flutter test")
          sh("flutter build ipa --release " \
             "--build-name=#{version} --build-number=#{build_number} " \
             "--export-options-plist=#{Shellwords.escape(export_options.path)} " \
             "--dart-define-from-file=#{Shellwords.escape(build_config.path)}")
        end
      end
    end

    ipa_directory = File.join(mobile_root, "build/ios/ipa")
    discovery_script = File.join(mobile_root, "scripts/find_signed_ipa.rb")
    ipa_output, ipa_error, ipa_status = Open3.capture3(
      RbConfig.ruby,
      discovery_script,
      ipa_directory,
      app_identifier,
    )
    UI.user_error!(ipa_error.strip.empty? ? ipa_output.strip : ipa_error.strip) unless ipa_status.success?
    ipa_path = ipa_output.strip

    upload_to_testflight(
      api_key: api_key,
      app_identifier: app_identifier,
      ipa: ipa_path,
      distribute_external: false,
      skip_waiting_for_build_processing: false,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "Automated internal TestFlight build."),
    )
  end
end
