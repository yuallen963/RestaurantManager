DATABASE_URL="postgresql://restaurant:restaurant@localhost:5432/restaurant_profit?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
PORT=3000
CORS_ORIGIN="http://localhost:3000"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false
OPENAI_API_KEY=""
OPENAI_INVOICE_MODEL="gpt-4.1-mini"
PRICE_CHANGE_PERCENT_THRESHOLD=5
PRICE_CHANGE_ABSOLUTE_THRESHOLD=0.50
FOOD_COST_DETERIORATION_THRESHOLD=2
LABOR_COST_DETERIORATION_THRESHOLD=2
VENDOR_SPEND_PERCENT_THRESHOLD=15
VENDOR_SPEND_DOLLAR_THRESHOLD=250
CATEGORY_SPEND_PERCENT_THRESHOLD=15
CATEGORY_SPEND_DOLLAR_THRESHOLD=200
ATTENTION_MEDIUM_SCORE_THRESHOLD=3
ATTENTION_HIGH_SCORE_THRESHOLD=5
ATTENTION_CRITICAL_SCORE_THRESHOLD=7
# Bank aggregation. Use BANK_PROVIDER=demo for deterministic local/simulator data.
BANK_PROVIDER=demo
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=
# Generate with: openssl rand -base64 32. Rotation requires decrypt/re-encrypt with the old key first.
BANK_TOKEN_ENCRYPTION_KEY=
SAVINGS_MINIMUM_PERCENTAGE_DIFFERENCE=5
SAVINGS_MINIMUM_MONTHLY_AMOUNT=25
INBOUND_EMAIL_PROVIDER=mailgun
INBOUND_EMAIL_WEBHOOK_SIGNING_KEY=
INVOICE_EMAIL_DOMAIN=
INVOICE_EMAIL_PREFIX=invoices
# Square POS. Keep secrets server-side; use sandbox for simulator development.
SQUARE_ENV=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URI=https://your-api.example.com/api/v1/pos/square/callback
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-api.example.com/api/v1/pos/square/webhook
# Optional app/universal-link destination after OAuth; without it the callback returns JSON success.
POS_OAUTH_SUCCESS_REDIRECT=
# Generate with: openssl rand -base64 32. Rotation requires decrypt/re-encrypt first.
POS_TOKEN_ENCRYPTION_KEY=
# Override only when intentionally pinning another supported Square API version.
SQUARE_API_VERSION=2026-09-16
POS_SYNC_INTERVAL_HOURS=24
