JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
PORT=3000
CORS_ORIGIN="http://localhost:3000"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false
OPENAI_API_KEY=""
OPENAI_INVOICE_MODEL="gpt-4.1-mini"
PRICE_CHANGE_PERCENT_THRESHOLD=5
PRICE_CHANGE_ABSOLUTE_THRESHOLD=0.50
FOOD_COST_DETERIORATION_THRESHOLD=2
LABOR_COST_DETERIORATION_THRESHOLD=2
VENDOR_SPEND_PERCENT_THRESHOLD=15
VENDOR_SPEND_DOLLAR_THRESHOLD=250
CATEGORY_SPEND_PERCENT_THRESHOLD=15
CATEGORY_SPEND_DOLLAR_THRESHOLD=200
ATTENTION_MEDIUM_SCORE_THRESHOLD=3
ATTENTION_HIGH_SCORE_THRESHOLD=5
ATTENTION_CRITICAL_SCORE_THRESHOLD=7
# Bank aggregation. Use BANK_PROVIDER=demo for deterministic local/simulator data.
BANK_PROVIDER=demo
PLAID_CLIENT_ID=
